# Copy to .env and fill in. Never commit .env.
# Variable names only here; see docs/CODING_SPEC.md §14.2 for where each value comes from.

# development | test | production
ENV=development
DATABASE_URL=postgresql+asyncpg://hrp:hrp@localhost:5432/hrp
# at least 32 random characters (openssl rand -hex 32)
AUTH_SECRET=change-me-to-at-least-32-random-characters
# comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Data sources
# EPC register token (README "EPC API token"): your own, from
# https://get-energy-performance-data.communities.gov.uk under "My Bearer token".
# Integration-site tokens are test-only. Put it in .env only; never in git or chat.
EPC_API_TOKEN=
# Empty = live API. For an integration (test) token use
# https://api.get-energy-performance-data.epb-integration.communities.gov.uk
EPC_API_BASE_URL=

# AI explanations (optional: template text is used without a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_DAILY_CALL_LIMIT=300

# Certificate storage: local | r2
STORAGE_BACKEND=local

# Front end
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 1 = front end answers from fixtures, no back end needed
NEXT_PUBLIC_API_MOCK=0

# M2 only (§14)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
MAIL_FROM=
