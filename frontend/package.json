{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm mocks:sync && next dev",
    "build": "pnpm mocks:sync && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm mocks:sync && tsc --noEmit",
    "test": "pnpm mocks:sync && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mocks:sync": "node scripts/mocks-sync.mjs",
    "types": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22 <23"
  }
}
